# Development only. Copy to .env locally; never commit real credentials.
NODE_ENV=development
HOST=127.0.0.1
PORT=8787

# Generate a long random value locally. Never use this example value.
FM001_API_KEY=replace-with-a-long-random-secret
FM001_ENABLED_PROVIDERS=
FM001_MAX_BODY_BYTES=1048576
FM001_REQUEST_TIMEOUT_MS=30000
FM001_RATE_LIMIT_PER_MINUTE=60

OPENAI_API_KEY=
OPENAI_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=

PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Human approval is mandatory for consequential external actions.
FM001_APPROVAL_MODE=human
FM001_ENVIRONMENT=staging
